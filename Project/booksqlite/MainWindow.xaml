<Window x:Class="booksqlite.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:booksqlite"
        mc:Ignorable="d"
        Title="Book Inventory Management" Height="600" Width="1000" Background="Thistle">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Label Grid.Row="0" HorizontalAlignment="Center" Content="Book Inventory CRUD Operations" 
               FontSize="24" FontWeight="SemiBold" Foreground="DarkSlateGray"/>

        <DataGrid Grid.Row="1" AutoGenerateColumns="False" Margin="10" Name="BookDG" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ISBN" Binding="{Binding ISBN}" Width="120"/>
                <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="200"/>
                <DataGridTextColumn Header="Author" Binding="{Binding AuthorName}" Width="150"/>
                <DataGridTextColumn Header="Genre" Binding="{Binding Genre.Name}" Width="100"/>
                <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat=C}" Width="80"/>
                <DataGridTextColumn Header="Stock" Binding="{Binding StockQuantity}" Width="60"/>
                <DataGridTextColumn Header="Published" Binding="{Binding PublishedDate, StringFormat=yyyy-MM-dd}" Width="100"/>
                <DataGridTemplateColumn Header="Actions" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Edit" Click="EditBook" Margin="2" Padding="5,2"/>
                                <Button Content="Delete" Click="DeleteBook" Margin="2" Padding="5,2"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- Add Book Form -->
            <Border Grid.Column="0" BorderBrush="Lavender" BorderThickness="3" Margin="5">
                <StackPanel Margin="10">
                    <Label Content="Add New Book" HorizontalAlignment="Center" FontWeight="Bold" FontSize="16" Foreground="DarkSlateGray"/>
                    <Grid x:Name="AddBookGrid" Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <Label Grid.Row="0" Grid.Column="0" Content="ISBN:" Margin="2"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ISBN}" Margin="2"/>

                        <Label Grid.Row="1" Grid.Column="0" Content="Title:" Margin="2"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Title}" Margin="2"/>

                        <Label Grid.Row="2" Grid.Column="0" Content="Author:" Margin="2"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding AuthorName}" Margin="2"/>

                        <Label Grid.Row="3" Grid.Column="0" Content="Genre:" Margin="2"/>
                        <ComboBox Grid.Row="3" Grid.Column="1" x:Name="AddGenreComboBox" 
                                  DisplayMemberPath="Name" SelectedValuePath="GenreId" 
                                  SelectedValue="{Binding GenreId}" Margin="2"/>

                        <Label Grid.Row="4" Grid.Column="0" Content="Price:" Margin="2"/>
                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Price}" Margin="2"/>

                        <Label Grid.Row="5" Grid.Column="0" Content="Stock:" Margin="2"/>
                        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding StockQuantity}" Margin="2"/>

                        <Label Grid.Row="6" Grid.Column="0" Content="Published:" Margin="2"/>
                        <DatePicker Grid.Row="6" Grid.Column="1" SelectedDate="{Binding PublishedDate}" Margin="2"/>

                        <Button Grid.Row="7" Grid.Column="1" Content="Add Book" Click="AddBook" 
                                Margin="2" Padding="10,5" Background="PaleGreen"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Update Book Form -->
            <Border Grid.Column="1" BorderBrush="Lavender" BorderThickness="3" Margin="5">
                <StackPanel Margin="10">
                    <Label Content="Update Book" HorizontalAlignment="Center" FontWeight="Bold" FontSize="16" Foreground="DarkSlateGray"/>
                    <Grid x:Name="UpdateBookGrid" Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <Label Grid.Row="0" Grid.Column="0" Content="ISBN:" Margin="2"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ISBN}" IsReadOnly="True" Margin="2" Background="LightGray"/>

                        <Label Grid.Row="1" Grid.Column="0" Content="Title:" Margin="2"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Title}" Margin="2"/>

                        <Label Grid.Row="2" Grid.Column="0" Content="Author:" Margin="2"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding AuthorName}" Margin="2"/>

                        <Label Grid.Row="3" Grid.Column="0" Content="Genre:" Margin="2"/>
                        <ComboBox Grid.Row="3" Grid.Column="1" x:Name="UpdateGenreComboBox" 
                                  DisplayMemberPath="Name" SelectedValuePath="GenreId" 
                                  SelectedValue="{Binding GenreId}" Margin="2"/>

                        <Label Grid.Row="4" Grid.Column="0" Content="Price:" Margin="2"/>
                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Price}" Margin="2"/>

                        <Label Grid.Row="5" Grid.Column="0" Content="Stock:" Margin="2"/>
                        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding StockQuantity}" Margin="2"/>

                        <Label Grid.Row="6" Grid.Column="0" Content="Published:" Margin="2"/>
                        <DatePicker Grid.Row="6" Grid.Column="1" SelectedDate="{Binding PublishedDate}" Margin="2"/>

                        <Button Grid.Row="7" Grid.Column="1" Content="Update Book" Click="UpdateBook" 
                                            Margin="2" Padding="10,5" Background="LightBlue"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
