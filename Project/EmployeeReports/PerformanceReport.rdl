  <DataSources>
    <DataSource Name="EmployeePerformanceDS">
      <DataSourceReference>EmployeePerformanceDS</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>2e6d5eeb-f26f-4fb7-84a9-42505e6626c6</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>EmployeePerformanceDS</DataSourceName>
        <CommandText>SELECT 
    EmployeeID,
    FirstName + ' ' + LastName AS EmployeeName,
    Department,
    YEAR(GETDATE()) AS SaleYear,
    MONTH(GETDATE()) AS SaleMonth,
    0 AS TotalSales,
    0 AS TargetAmount,
    0 AS Variance,
    'Test' AS TargetStatus,
    0 AS PercentageOfTarget
FROM Employees
WHERE IsActive = 1</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="EmployeeID">
          <DataField>EmployeeID</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="EmployeeName">
          <DataField>EmployeeName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Department">
          <DataField>Department</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SaleYear">
          <DataField>SaleYear</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="SaleMonth">
          <DataField>SaleMonth</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="TotalSales">
          <DataField>TotalSales</DataField>
